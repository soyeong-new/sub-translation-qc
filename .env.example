# docker-compose.yml의 frontend(Caddy) 서비스가 읽는다.
# 이 파일을 .env로 복사해서 실제 값을 채운 뒤 사용한다 (.env는 git에
# 올라가지 않는다).

# 실서버에선 실제 도메인, 로컬 테스트는 localhost로 둔다.
DOMAIN=localhost

BASIC_AUTH_USER=admin

# 아래 명령으로 생성한다:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext <비밀번호>
# 결과 값의 모든 "$"를 "$$"로 두 배로 바꿔서 붙여넣는다 — docker compose가
# .env 파일 안의 "$"를 자기 변수 치환 문법으로 오인해서 해시를 조용히
# 깨트린다(예: "$2a$14$Pl..."의 "$Pl" 부분이 사라짐, 실측 확인됨).
# 예) $2a$14$Pl.abc... → $$2a$$14$$Pl.abc...
BASIC_AUTH_HASH=
